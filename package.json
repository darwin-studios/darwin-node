{
    "name": "@darwinso/sdk",
    "version": "0.1.0",
    "private": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/darwin-studios/darwin-node.git"
    },
    "type": "commonjs",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.mjs",
    "types": "./dist/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.mts",
                "default": "./dist/esm/index.mjs"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            },
            "default": "./dist/cjs/index.js"
        },
        "./agent": {
            "import": {
                "types": "./dist/esm/api/resources/agent/exports.d.mts",
                "default": "./dist/esm/api/resources/agent/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/agent/exports.d.ts",
                "default": "./dist/cjs/api/resources/agent/exports.js"
            },
            "default": "./dist/cjs/api/resources/agent/exports.js"
        },
        "./tools": {
            "import": {
                "types": "./dist/esm/api/resources/tools/exports.d.mts",
                "default": "./dist/esm/api/resources/tools/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/tools/exports.d.ts",
                "default": "./dist/cjs/api/resources/tools/exports.js"
            },
            "default": "./dist/cjs/api/resources/tools/exports.js"
        },
        "./goals": {
            "import": {
                "types": "./dist/esm/api/resources/goals/exports.d.mts",
                "default": "./dist/esm/api/resources/goals/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/goals/exports.d.ts",
                "default": "./dist/cjs/api/resources/goals/exports.js"
            },
            "default": "./dist/cjs/api/resources/goals/exports.js"
        },
        "./approvals": {
            "import": {
                "types": "./dist/esm/api/resources/approvals/exports.d.mts",
                "default": "./dist/esm/api/resources/approvals/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/approvals/exports.d.ts",
                "default": "./dist/cjs/api/resources/approvals/exports.js"
            },
            "default": "./dist/cjs/api/resources/approvals/exports.js"
        },
        "./integrations": {
            "import": {
                "types": "./dist/esm/api/resources/integrations/exports.d.mts",
                "default": "./dist/esm/api/resources/integrations/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/integrations/exports.d.ts",
                "default": "./dist/cjs/api/resources/integrations/exports.js"
            },
            "default": "./dist/cjs/api/resources/integrations/exports.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "reference.md",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "format": "biome format --write --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "format:check": "biome format --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "lint": "biome lint --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "lint:fix": "biome lint --fix --unsafe --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "check": "biome check --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "check:fix": "biome check --fix --unsafe --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "build": "pnpm build:cjs && pnpm build:esm",
        "build:cjs": "tsc --project ./tsconfig.cjs.json",
        "build:esm": "tsc --project ./tsconfig.esm.json && node scripts/rename-to-esm-files.js dist/esm",
        "test": "vitest",
        "test:unit": "vitest --project unit",
        "test:wire": "vitest --project wire"
    },
    "dependencies": {},
    "devDependencies": {
        "webpack": "^5.105.4",
        "ts-loader": "^9.5.4",
        "vitest": "^4.1.1",
        "msw": "2.11.2",
        "@types/node": "^20.0.0",
        "typescript": "~5.9.3",
        "@biomejs/biome": "2.4.10"
    },
    "browser": {
        "fs": false,
        "os": false,
        "path": false,
        "stream": false,
        "crypto": false
    },
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=18.0.0"
    },
    "sideEffects": false,
    "description": "Official TypeScript SDK for Darwin",
    "license": "MIT",
    "homepage": "https://docs.darwin.so/sdks/typescript",
    "bugs": {
        "url": "https://github.com/darwin-studios/darwin-node/issues"
    }
}
