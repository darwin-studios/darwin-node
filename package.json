{
  "name": "@darwinso/sdk",
  "version": "0.2.0",
  "description": "Official TypeScript SDK for Darwin",
  "keywords": [
    "darwin",
    "agent",
    "sdk"
  ],
  "homepage": "https://docs.darwin.so/sdks/typescript",
  "bugs": {
    "url": "https://github.com/darwin-studios/darwin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darwin-studios/darwin-node.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.6.3",
  "main": "./generated/cjs/index.js",
  "module": "./generated/esm/index.mjs",
  "types": "./generated/esm/index.d.mts",
  "exports": {
    ".": {
      "types": "./generated/esm/index.d.mts",
      "import": "./generated/esm/index.mjs",
      "require": "./generated/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "generated",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/verify-generated.mjs",
    "check-types": "node scripts/verify-generated.mjs",
    "test": "node scripts/verify-generated.mjs && node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
